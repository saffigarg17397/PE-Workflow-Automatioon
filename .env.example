# Required: your Google AI Studio key. Free, no card, no phone verification —
# aistudio.google.com -> Get API key. New keys start with 'AQ.'; older ones
# start with 'AIza' and are being retired through 2026. Either works here.
GEMINI_API_KEY=your-key-here

# Optional overrides
CIM_MODEL=gemini-3.6-flash
CIM_DB_URL=sqlite:///./cim_memo.db
CIM_DEFAULT_THESIS=services_rollup

# --- public hosting ---
# Read-only demo: serves pre-generated memos, live runs disabled. Calls are free
# on the AI Studio tier, so this is now about rate limits and abuse rather than
# cost — 1,500 requests/day is shared across every visitor.
CIM_DEMO_MODE=false
# Set to re-enable live runs on a hosted instance (e.g. to demo in an interview).
CIM_RUN_PASSWORD=
# Optional line shown on the demo landing page.
CIM_DEMO_BANNER=
