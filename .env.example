# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
CIM_MODEL=claude-opus-5
CIM_DB_URL=sqlite:///./cim_memo.db
CIM_DEFAULT_THESIS=services_rollup

# --- public hosting ---
# Read-only demo: serves pre-generated memos, live runs disabled. Set this on
# any instance whose URL you share — otherwise visitors spend your API credits.
CIM_DEMO_MODE=false
# Set to re-enable live runs on a hosted instance (e.g. to demo in an interview).
CIM_RUN_PASSWORD=
# Optional line shown on the demo landing page.
CIM_DEMO_BANNER=
